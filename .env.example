MONGODB_URI=mongodb+srv://mizona-admin:TU_PASSWORD@cluster0.xxxxx.mongodb.net/mizona?retryWrites=true&w=majority
PORT=5000
ANTHROPIC_API_KEY=tu-api-key-de-claude-aca
MI_ASISTENTE_API_URL=https://empleado-virtual-ia.onrender.com/api
# Clave compartida con Mi Asistente (TIENE QUE SER LA MISMA que INTEGRACION_KEY allá). Protege las
# estadísticas privadas del dueño y le da a este servidor un límite de pedidos más alto en Mi Asistente.
INTEGRACION_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Inicio de sesión con Google ---
# Es el MISMO ID de cliente que usa Mi Asistente. Además hay que agregar la dirección de Mi Zona
# (la de Netlify) en Google Cloud → Credenciales → tu ID de cliente → "Orígenes autorizados de JavaScript".
GOOGLE_CLIENT_ID=553562775987-ovo25d12tq3fhntvj34342nk3jlg7vtc.apps.googleusercontent.com
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Correo (código de ingreso) ---
# Render gratis no permite SMTP: se envía por API. Opción recomendada: Brevo (gratis, no pide dominio propio).
# 1) Creá la cuenta en brevo.com  2) Remitentes → agregá y verificá tu correo  3) SMTP y API → API Keys → creá una clave
# Opción SIN registrarte en nada (recomendada): enviar desde tu propio Gmail con un script de Google. Pasos en correo-apps-script.gs
APPS_SCRIPT_URL=
APPS_SCRIPT_CLAVE=
# (Alternativas: Brevo o Resend, ver abajo)
BREVO_API_KEY=
# Correo ya verificado en Brevo. Formato: Mi Zona <tu-correo@gmail.com>
CORREO_REMITENTE=
# Alternativa a Brevo (necesita dominio propio verificado): RESEND_API_KEY=

# --- Planes y cobro (Google Play Billing) ---
# Se cobra SOLO por un negocio, un oficio o un alquiler. El cobro lo hace Google Play: estas dos variables permiten que el servidor
# le pregunte a Google si una compra es real (sin ellas el servidor no acredita ninguna compra). Pasos en play-store/GUIA-PLAY-STORE.md
PLAY_PACKAGE_NAME=
# JSON completo de la cuenta de servicio de Google Cloud con acceso a Play Console, en UNA sola línea
PLAY_SERVICE_ACCOUNT_JSON=
# URL de la web (Netlify), sin barra al final (CORS)
FRONTEND_URL=https://TU-WEB-DE-MI-ZONA.netlify.app
# Precios de REFERENCIA en pesos (1 mes). Los precios reales de cobro se cargan en Play Console. 3 meses = 10% menos; 6 meses = 20% menos.
PRECIO_NEGOCIO_1_MES=3000
PRECIO_OFICIO_1_MES=1000
PRECIO_ALQUILER_1_MES=2000
# Invitaciones: días que gana quien invita, días que gana quien se registra con el código, y tope de días ganados por invitar
INVITACION_DIAS=5
INVITACION_DIAS_INVITADO=5
INVITACION_TOPE_DIAS=60

# --- Notificaciones push (se generan UNA sola vez con: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@tudominio.com

# Clave para llamar desde un cron externo a /api/suscripcion/revisar-vencimientos (avisos de vencimiento)
CRON_KEY=cambia_esto_por_otra_clave_larga

# --- Soporte (Ajustes → Soporte) ---
# Clave del equipo para leer y responder consultas en https://TU-SERVIDOR.onrender.com/api/soporte/panel (poné una larga y única)
SOPORTE_ADMIN_KEY=cambia_esto_por_una_clave_larga
# Opcional: enlace (webhook) de Slack, Discord, Make o Zapier para que te avise cada vez que llega una consulta nueva
SOPORTE_AVISO_URL=

# --- Comunidad (Fase 7) ---
# La sección está APAGADA hasta tener lista la moderación (Fase 8). Para probarla, poné true y reiniciá el servidor.
COMUNIDAD_HABILITADA=false

# --- Moderación (Fase 8) ---
# Verificación en dos pasos del panel de moderación (/api/moderacion/panel). Generala UNA vez en tu computadora con:  node scripts/generar-totp.mjs
# El panel usa además SOPORTE_ADMIN_KEY (la misma clave del soporte). Sin las dos, el panel no abre y Comunidad sigue apagada.
MODERACION_TOTP_SECRET=
