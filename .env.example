# Variables de la WEB (se cargan en Netlify → Site configuration → Environment variables, o en un archivo .env.production al compilar).
# Las que empiezan con VITE_ quedan visibles dentro de la web: nunca pongas claves secretas acá.

# URL del servidor con /api al final, SIN barra final. OBLIGATORIA: si falta, la app publicada intenta hablar con "localhost" y no carga nada.
VITE_API_URL=https://TU-SERVIDOR-DE-MI-ZONA.onrender.com/api

# ID de cliente de Google (opcional: ya viene uno por defecto)
VITE_GOOGLE_CLIENT_ID=

# Contacto en Ajustes → Soporte y en las páginas legales. VITE_SOPORTE_EMAIL es OBLIGATORIO para Google Play (política de privacidad).
VITE_SOPORTE_EMAIL=
VITE_SOPORTE_WHATSAPP=

# Nombre de la persona o empresa responsable (aparece al pie de las páginas legales)
LEGAL_TITULAR=

# Enlace de Mi Asistente en Google Play (opcional)
VITE_PLAY_STORE_URL=
